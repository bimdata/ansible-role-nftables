#!/usr/sbin/nft -f

{# Remove the _source_var from the variables #}
{% set ns = namespace(
    t_has_content=false,
    nftables_tables = _nftables_tables | community.general.remove_keys(target="_source_var"),
    nftables_chains = _nftables_chains | community.general.remove_keys(target="_source_var"),
    nftables_defines = _nftables_defines | community.general.remove_keys(target="_source_var"),
    nftables_sets = _nftables_sets | community.general.remove_keys(target="_source_var"),
    nftables_maps = _nftables_maps | community.general.remove_keys(target="_source_var"),
    nftables_objects = _nftables_objects | community.general.remove_keys(target="_source_var"),
    nftables_rules = _nftables_rules | community.general.remove_keys(target="_source_var")
) -%}
{% macro t_new_section(title) %}
    {% if ns.t_has_content %}

    {% endif %}
    {% set ns.t_has_content = true -%}
    {{ title | comment(prefix_count=0, postfix_count=0) | indent(4, first=true)}}
{% endmacro -%}

{{ ansible_managed | comment }}

# Clean
{% if nftables_flush_ruleset | bool -%}
    flush ruleset
{% else %}
    {% for table_def in ns.nftables_tables %}
        {% for command in ['table', 'delete table'] -%}
            {{ command }} {{ table_def.table }}
        {% endfor %}
    {% endfor %}
{% endif %}

{% if (ns.nftables_defines | length) > 0 %}
{% set merged_defines = ns.nftables_defines | combine %}
# Define
    {% for name, value in merged_defines.items() %}
        {% if value is string %}
            {% set _content = value %}
            {% set _definition = "define " ~ name ~ " = " ~ value -%}
        {% else %}
            {% set _definition = "define " ~ name ~ " = {\n" ~ value | join(",\n") | indent(4, first=true) ~ "\n}" %}
        {% endif -%}
        {{ _definition }}
    {% endfor %}
{% endif %}

{% for table_def in ns.nftables_tables %}
{% set table = table_def.table %}
table {{ table }} {
    {% set ns.t_has_content = false -%}
    {% if table_def.comment is defined %}
    comment "{{ table_def.comment }}"
    {% set ns.t_has_content = true %}
    {% endif %}
    {% if (table_def.flags | default([]) | length) > 0 %}
    flags {{ table_def.flags | join(', ') }}
    {% set ns.t_has_content = true %}
    {% endif %}
    {% set is_default_table = table == nftables_table_use_by_default -%}

    {# Merge variables #}
    {# Data from the default table #}
    {% if is_default_table %}
        {% set merged_sets = ns.nftables_sets | selectattr('table', 'undefined') | combine %}
        {% set merged_maps = ns.nftables_maps | selectattr('table', 'undefined') | combine %}
        {% set merged_objects = ns.nftables_objects | selectattr('table', 'undefined') %}
        {% set merged_chains = ns.nftables_chains | selectattr('table', 'undefined') %}
    {% endif -%}

    {# Then explicit object definition #}
    {% set merged_sets = merged_sets | default({}) | combine(
            ns.nftables_sets
            | selectattr('table', 'defined')
            | selectattr('table', 'equalto', table)
            | combine
        )
    %}
    {% set merged_maps = merged_maps | default({}) | combine(
            ns.nftables_maps
            | selectattr('table', 'defined')
            | selectattr('table', 'equalto', table)
            | combine
        )
    %}
    {% set merged_objects = merged_objects | default([]) + (ns.nftables_objects | selectattr('table', 'defined') | selectattr('table', 'equalto', table)) %}
    {% set merged_chains = merged_chains | default([]) + (ns.nftables_chains | selectattr('table', 'defined') | selectattr('table', 'equalto', table)) %}

    {%- if (merged_objects | length) > 0 -%}
        {{ t_new_section(title="Object definitions") }}
        {%- for object in merged_objects %}
            {% if object.content is not defined  or (object.content.splitlines() | length) == 0 %}
                {% set _definition = object.type ~ " " ~ object.name ~ " {}" %}
            {% elif (object.content.splitlines() | length) == 1 %}
                {% set _definition = object.type ~ " " ~ object.name ~ " {" ~ object.content ~ "}" %}
            {% else %}
                {% set _definition = object.type ~ " " ~ object.name ~ " {\n" ~ object.content | indent(4, first=true) ~ "\n}" %}
            {% endif -%}
            {{ _definition | indent(4, first=true) }}
        {% endfor %}
    {% endif -%}

    {%- if (merged_sets | length) > 0 -%}
        {{ t_new_section(title="Set definitions") }}
        {%- for name, value in merged_sets.items() if name != "table" %}
            {% if (value.splitlines() | length) > 0 %}
                {% set _definition = "set " ~ name ~ " {\n" ~ value | indent(4, first=true) ~ "\n}" -%}
            {% else %}
                {% set _definition = "set " ~ name ~ " {" ~ value ~ "}" -%}
            {% endif -%}
            {{ _definition | indent(4, first=true) }}
        {% endfor %}
    {% endif -%}

    {%- if (merged_maps | length) > 0 -%}
        {{ t_new_section(title="Map definitions") }}
        {%- for name, value in merged_maps.items() if name != "table" %}
            {% if (value.splitlines() | length) > 0 %}
                {% set _definition = "map " ~ name ~ " {\n" ~ value | indent(4, first=true) ~ "\n}" -%}
            {% else %}
                {% set _definition = "map " ~ name ~ " {" ~ value ~ "}" -%}
            {% endif -%}
            {{ _definition | indent(4, first=true) }}
        {% endfor %}
    {% endif -%}

    {% if (merged_chains | length) > 0 -%}
    {{ t_new_section(title="Chain definitions") }}
    {%- for chain in merged_chains %}
    chain {{ chain.name }} {
        {# rules define with the chain #}
        {% set merged_rules = chain.rules | default({}) %}
        {% if is_default_table %}
            {# default table rule definition #}
            {% set merged_rules = merged_rules | combine(
                    ns.nftables_rules
                    | selectattr('table', 'undefined')
                    | selectattr('chain', 'equalto', chain.name)
                    | map(attribute='rules')
                    | combine
                )
            %}
        {% endif %}
        {# rules with explicit table #}
        {% set merged_rules = merged_rules | combine(
                ns.nftables_rules
                | selectattr('table', 'defined')
                | selectattr('table', 'equalto', table)
                | selectattr('chain', 'equalto', chain.name)
                | map(attribute='rules')
                | combine
            )
        %}
        {% if (merged_rules | length) > 0 -%}
            {# We sort the rules by the key alphabetical order, 0 is the key when using items() #}
            {% for key, value in merged_rules.items() | sort(attribute='0') -%}
                {% if value is not none and value | trim | length > 0 -%}
                    {{ value | indent(8, first=true) }}
                {% endif %}
            {% endfor %}
        {% endif %}
    }
    {% endfor %}
    {% endif %}
}
{% endfor %}
